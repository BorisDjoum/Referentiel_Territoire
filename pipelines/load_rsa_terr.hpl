  <transform>
    <type>TableInput</type>
    <name>INPUT_RSA</name>
    <sql>SELECT 
    t1.DTREF,
    t1.INDI,
    t1.SEXE,
	t1.AGE,
    t1.SITFAM,
    t1.NB_ENFANTS,
    t2.CODEINSEE
FROM insertion.inaam_f_brsapardtref t1
LEFT JOIN insertion.inaam_f_brsaterritoire t2 
    ON t1.indi = t2.indi 
    AND t1.dtref = t2.dtref</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
